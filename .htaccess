# Normalize explicit index.html only for browser requests, not DirectoryIndex subrequests.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
